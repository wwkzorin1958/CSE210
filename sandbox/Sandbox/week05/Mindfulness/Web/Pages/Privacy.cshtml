@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}
<section class="prose-page">
    <span class="eyebrow">YOUR PRIVACY</span>
    <h1>A note about your data.</h1>
    <p>Each account can view only its own activity history. Anyone on the configured network can create an account.</p>
    <p>Your password is stored as a password hash. Activity responses are stored unencrypted in the server's local database, so the computer's administrator can access them. Use HTTPS with a trusted certificate on every device.</p>
    <p>Web histories are separate from the console and desktop history. No email or password recovery service is configured.</p>
</section>
